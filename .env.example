# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is git-ignored. This file is committed — NEVER put a real value in it.

# --- Server ------------------------------------------------------------------
PORT=3000

# --- Database (Week 3, Docker Postgres) --------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# --- Supabase Auth (Week 4) --------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SUPERPASS=

# --- LLM provider (POST /enrich) ---------------------------------------------
# These three are the only difference between a hosted model and a local one.
#   OpenRouter: https://openrouter.ai/api/v1   your key     openrouter/free
#   Ollama:     http://localhost:11434/v1/     ollama       gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# --- LLM switches ------------------------------------------------------------
# LLM_STUB=1         skip the model, return a fixed schema-valid answer (free dev)
# LLM_ENABLED=false  kill switch: no model calls, return a deterministic fallback
LLM_STUB=1
LLM_ENABLED=true
